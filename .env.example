# ==============================================================================
# Peblo TV Mini — Environment Variables Template (.env.example)
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# Application Configuration
PROJECT_NAME="Peblo TV Mini API"
API_V1_STR=/api/v1
SECRET_KEY=your-jwt-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (Default): sqlite+aiosqlite:///./peblo.db
# PostgreSQL (Production/Docker): postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=sqlite+aiosqlite:///./peblo.db

# Storage Provider (local | r2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# Cloudflare R2 / AWS S3 (Only required if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=peblo-tv-mini-catalogue
R2_PUBLIC_URL=https://cdn.yourdomain.com

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]
