# Application Settings
PROJECT_NAME="Peblo TV Mini API"
API_V1_STR=/api/v1
SECRET_KEY=peblo-mini-secret-key-development-mode-only-super-safe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supports SQLite for dev and PostgreSQL for production)
DATABASE_URL=postgresql+asyncpg://postgres:hello123@localhost:5433/peblo_db

# Storage Provider (local | r2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# Cloudflare R2 / AWS S3 (Used when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=peblo-tv-mini-catalogue
R2_PUBLIC_URL=https://cdn.peblo.tv

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

